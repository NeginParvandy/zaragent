# Holding Smart Agent 2.4.6 - Offline Windows Server Edition
# Copy this file to .env and review all server-specific values before starting.

APP_NAME=Holding Smart Agent
APP_VERSION=2.4.6
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
ENABLE_DOCS=true

# Windows Server runtime
HOST=0.0.0.0
PORT=13657
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.50.153
FORCE_HTTPS=false
FORWARDED_ALLOW_IPS=127.0.0.1

# Compatible with the current application backend: no new mandatory header.
AUTH_REQUIRED=false
AGENT_API_KEY=
TRUSTED_GATEWAY_HEADER=X-Employee-Id
ENABLE_ADMIN_ENDPOINTS=false
ADMIN_API_KEY=

# Existing organization APIs
HR_API_BASE_URL=https://var-prd-test3.zarholding.com:4433
FOOD_API_BASE_URL=https://var-prd-test3.zarholding.com:4433
API_VERSION=1
REQUEST_TIMEOUT_SECONDS=15
CONNECT_TIMEOUT_SECONDS=5
USE_CASE_TIMEOUT_SECONDS=45
VERIFY_SSL=true
INTERNAL_CA_BUNDLE=
EXTERNAL_GET_RETRIES=2
RETRY_BACKOFF_SECONDS=0.25
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30

# Optional local defaults. Real values normally arrive in the request body/session.
DEFAULT_EMPLOYEE_ID=
DEFAULT_AUTH_TOKEN=
DEFAULT_USERNAME_HASH=
DEFAULT_PASSWORD_HASH=
DEFAULT_DIGIT_CODE=

DEFAULT_RESTAURANT_ID=84
DEFAULT_MEAL_ID=1
MAX_RATING_LOOKUPS=6
RATING_LOOKUP_CONCURRENCY=3
LOW_CAPACITY_THRESHOLD=5

SQLITE_PATH=data/agent_state.db
SQLITE_BUSY_TIMEOUT_MS=5000
PENDING_ACTION_EXPIRE_MINUTES=30
PROCESSING_STALE_MINUTES=15
MAINTENANCE_INTERVAL_MINUTES=60
REMINDER_DEDUP_HOURS=24
MONTH_END_REMINDER_DAYS=3
ACTION_RETENTION_DAYS=30
REMINDER_RETENTION_DAYS=90

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
LOG_PATH=logs/agent.log
LOG_BACKUP_COUNT=14
